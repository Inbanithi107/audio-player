<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ProgressBar?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"

      alignment="CENTER"
      spacing="18"
      stylesheets="@../css/audioplayer-view.css"
      style="
          -fx-background-color: linear-gradient(
        to bottom right,
        #111827,
        #0f172a
    );
          -fx-background-radius: 20;
      ">

    <padding>
        <Insets top="30"
                right="35"
                bottom="30"
                left="35"/>
    </padding>


    <!-- ========================= -->
    <!-- Audio Name                -->
    <!-- ========================= -->

    <Label fx:id="audioNameLabel"
           style="
               -fx-text-fill: white;
               -fx-font-size: 24px;
               -fx-font-weight: bold;
           "/>


    <!-- ========================= -->
    <!-- Cover Image               -->
    <!-- ========================= -->

    <ImageView fx:id="coverImageView"

               fitWidth="280"
               fitHeight="280"

               preserveRatio="true"

               smooth="true"

               style="
                   -fx-background-color: #222222;
               "/>


    <!-- ========================= -->
    <!-- Metadata                  -->
    <!-- ========================= -->

    <Label fx:id="metadataLabel"
           text="Artist • Album • 2026"

           style="
               -fx-text-fill: #aaaaaa;
               -fx-font-size: 14px;
           "/>


    <!-- ========================= -->
    <!-- Progress Section          -->
    <!-- ========================= -->

    <HBox alignment="CENTER"
          spacing="10"
          maxWidth="400">

        <Label fx:id="currentTimeLabel"
               text="00:00"

               style="
                   -fx-text-fill: #aaaaaa;
                   -fx-font-size: 12px;
               "/>


        <Slider fx:id="progressSlider"
                min="0"
                max="100"
                styleClass="progress-slider"
                HBox.hgrow="ALWAYS"/>


        <Label fx:id="totalTimeLabel"
               text="00:00"

               style="
                   -fx-text-fill: #aaaaaa;
                   -fx-font-size: 12px;
               "/>

    </HBox>


    <!-- ========================= -->
    <!-- Player Controls           -->
    <!-- ========================= -->

    <HBox alignment="CENTER"
          spacing="25">

        <!-- Previous -->

        <Button fx:id="previousButton"
                text="⏮"

                prefWidth="50"
                prefHeight="50"

                style="
                    -fx-background-color: #292929;
                    -fx-text-fill: white;
                    -fx-font-size: 18px;
                    -fx-background-radius: 50;
                    -fx-cursor: hand;
                "/>


        <!-- Play / Resume -->

        <Button fx:id="playButton"
                text="▶"

                prefWidth="65"
                prefHeight="65"

                style="
                    -fx-background-color: #6C63FF;
                    -fx-text-fill: white;
                    -fx-font-size: 25px;
                    -fx-background-radius: 50;
                    -fx-cursor: hand;
                "/>


        <!-- Next -->

        <Button fx:id="nextButton"
                text="⏭"

                prefWidth="50"
                prefHeight="50"

                style="
                    -fx-background-color: #292929;
                    -fx-text-fill: white;
                    -fx-font-size: 18px;
                    -fx-background-radius: 50;
                    -fx-cursor: hand;
                "/>

    </HBox>

</VBox>